{
  "name": "public-blog",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "deploy": "npm run cf:deploy",
    "cf:preview": "opennextjs-cloudflare build && node scripts/prepare-cloudflare-assets.mjs && wrangler dev",
    "cf:deploy": "opennextjs-cloudflare build && node scripts/prepare-cloudflare-assets.mjs && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv",
    "bamboo:seo:dry-run": "npx tsx scripts/bamboo_seo_migration.ts --dry-run",
    "bamboo:seo:migrate": "npx tsx scripts/bamboo_seo_migration.ts --migrate",
    "bamboo:seo:retry-failed": "npx tsx scripts/bamboo_seo_migration.ts --retry-failed",
    "bamboo:seo:status": "npx tsx scripts/bamboo_seo_migration.ts --status"
  },
  "dependencies": {
    "@codemirror/lang-html": "^6.4.11",
    "@opennextjs/cloudflare": "^1.20.1",
    "@supabase/supabase-js": "^2.110.6",
    "@tiptap/core": "^3.24.0",
    "@tiptap/extension-bubble-menu": "^3.24.0",
    "@tiptap/extension-image": "^3.24.0",
    "@tiptap/extension-mention": "^3.24.0",
    "@tiptap/extension-table": "^3.24.0",
    "@tiptap/extension-table-cell": "^3.24.0",
    "@tiptap/extension-table-header": "^3.24.0",
    "@tiptap/extension-table-row": "^3.24.0",
    "@tiptap/react": "^3.24.0",
    "@tiptap/starter-kit": "^3.24.0",
    "@tiptap/suggestion": "^3.28.0",
    "@types/js-beautify": "^1.14.3",
    "@types/pg": "^8.20.0",
    "@typesafe-ai/sdk": "^0.6.0",
    "@uiw/react-codemirror": "^4.25.11",
    "compressorjs": "^1.3.0",
    "echarts": "^6.0.0",
    "echarts-for-react": "^3.0.6",
    "googleapis": "^172.0.0",
    "html-react-parser": "^6.0.1",
    "html2canvas": "^1.4.1",
    "js-beautify": "^1.15.4",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.4",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.20.0",
    "pg-cloudflare": "^1.4.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-pdf": "^10.4.1",
    "sharp": "^0.34.5"
  },
