# Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# PostgreSQL connection string (use your Supabase connection pooler for serverless)
DATABASE_URL=postgresql://postgres.your-project:password@aws-0-region.pooler.supabase.com:6543/postgres

# Public website origin
SITE_URL=http://localhost:3000
RUNTIME_PLATFORM=

# Required for scheduled IndexNow endpoint authorization
CRON_SECRET=replace-with-a-long-random-value

# Single owner account (keep these secrets private)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-a-long-random-value

# Optional integrations
ADMIN_SECRET=replace-with-a-different-long-random-value
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
INDEXNOW_KEY=
NEXT_PUBLIC_KAKAO_JS_KEY=
SLACK_WEBHOOK_URL=
